# ------------------------------------------------------------------
# Business OS environment variables
# Copy to .env.local for local development. NEVER commit real values.
# ------------------------------------------------------------------

# --- Supabase (Project Settings → API) ----------------------------
# Public, safe in the browser — authorization is enforced by Postgres RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Grants full access bypassing RLS. Do NOT import in client code.
# Currently used only for admin operations (e.g. account deletion).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App -----------------------------------------------------------
# Canonical public URL of the app (used for OAuth/email redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (post-MVP, Phase: Billing) -----------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
